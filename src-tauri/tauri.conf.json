{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kairos",
  "version": "0.1.0",
  "identifier": "dev.kairos.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kairos",
        "width": 1180,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "publisher": "Kairos",
    "copyright": "Copyright (c) 2026 Kairos contributors. MIT License.",
    "category": "Game",
    "shortDescription": "An independent launcher for Minecraft: Java Edition",
    "longDescription": "Kairos is an independent, community-made launcher for Minecraft: Java Edition. It is not affiliated with Mojang or Microsoft.",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Polish",
          "German",
          "Spanish",
          "French",
          "PortugueseBR",
          "Russian"
        ],
        "displayLanguageSelector": true,
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4N0NFOUFEM0Q3MTlGMUEKUldRYW4zRTlyZWw4YUZleEtCYVRCMUVzeGtVTnpJSWZWalpsTFBaZEpwbzgrWXRpTW1wd3psS0YK",
      "endpoints": [
        "https://github.com/Kokosek-Dev/Kairos/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
